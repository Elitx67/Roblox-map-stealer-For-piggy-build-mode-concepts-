local function refreshFileList()
    for _, v in ipairs(ExpScroll:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    local files = {}
    if listfiles then
        pcall(function()
            for _, file in ipairs(listfiles(folderPath)) do
                local name = file:match("([^/\\]+)%.json$")
                if name and isfile(file) then
                    local sizeKb = 0
                    pcall(function() sizeKb = string.len(readfile(file)) / 1024 end)
                    table.insert(files, {name = name, size = string.format("%.1f KB", sizeKb)})
