    uploadCancelFlag = false

    loadAssets()
    local remotes = getRemotes()
    local pb = remotes.PlaceBlock
    local cr = remotes.CommitResize
    local cm = remotes.CommitMove
    local paint = remotes.PaintBlock
    local remove = remotes.RemoveBlock
    local ar = remotes.AdvancedRotate

    if not pb or not cr or not cm then
        Status.Text = translate("Error: Remotes not found")
        showNotification("Remotes not found (PlaceBlock, ScaleBlock, MoveBlock)", 2, Colors.Accent)
        return
    end

    local file = folderPath .. MapInputBtn.Text .. ".json"
    if not isfile(file) then
        Status.Text = translate("File not found")
        showNotification("File not found", 2, Colors.Accent)
        return
    end

    local rawData = Services.Http:JSONDecode(readfile(file))
    cleanupHandles()

    ProgressFrame.Visible = true
    Fill.Size = UDim2.new(0, 0, 0, 12)

    local blocksData = rawData.blocks or rawData
    local totalBlocks = #blocksData
    local total = totalBlocks

    if total == 0 then
        ProgressFrame.Visible = false
        Status.Text = translate("No data to upload")
        showNotification("No data", 2, Colors.Accent)
        return
    end

    local dynamicWaitTime = settings.buildDelay
    if settings.dynamicRateLimit then
        local targetRate = math.min(settings.maxBlocksPerSecond, math.max(20, totalBlocks / 30)) 
        dynamicWaitTime = math.max(0.01, 1 / targetRate)
    end

    local startTime = tick()
    local processed = 0
    local failedCount = 0
    local skippedCount = 0
    local searchTimeout = settings.searchTimeout or 20

    local blocksToBuild = {}

    local function findPlacedBlock(spawnPos, maxAttempts)
        local attempts = 0
        while attempts < maxAttempts and not uploadCancelFlag do
            attempts = attempts + 1
            local pbContainer = workspace:FindFirstChild("PlacedBlocks") or workspace:FindFirstChild("Blocks") or workspace
            if pbContainer then
                for _, v in ipairs(pbContainer:GetDescendants()) do
                    if v:IsA("BasePart") and (v:GetPivot().Position - spawnPos).Magnitude < 5 then
                        return v
                    end
                end
            end
            task.wait(0.1)
        end
        return nil
    end

    task.spawn(function()
        for i = 1, totalBlocks do
            if uploadCancelFlag then
                Status.Text = translate("Upload Cancelled by user")
                showNotification("Cancelled", 2, Colors.Accent)
                ProgressFrame.Visible = false
                return
            end

            local d = blocksData[i]
            if not d then
                processed = processed + 1
                failedCount = failedCount + 1
                continue
            end

            if settings.dontBuildInvBlocks and d.pt == "Invisible" then
                skippedCount = skippedCount + 1
                processed = processed + 1
                continue
            end
            if not settings.loadInvLights and d.pt == "InvisibleLight" then
                skippedCount = skippedCount + 1
                processed = processed + 1
                continue
            end

            local s = d.s and {unpack(d.s)} or {1,1,1}
            local c = d.c and {unpack(d.c)} or {1,1,1}
            local p = d.p and {unpack(d.p)} or {0,0,0}
            local r = d.r and {unpack(d.r)} or {0,0,0}
            local mat = d.m or "Plastic"
            local transparency = d.t or 0
            local light = d.light
            local bType = d.pt or "Normal"

            if not isClassicMaterial(mat) then
                mat = "Plastic"
            end
            local material = getClassicMaterial(mat)

            local template = Sustitutos["Standard"]
            if bType == "NoClip" then
                template = Sustitutos["NoClipEvent"] or Sustitutos["NoClip"] or Sustitutos["Standard"]
            elseif bType == "Cylinder" then
                template = Sustitutos["Cylinder"] or Sustitutos["Standard"]
            elseif bType == "Transparent" then
                template = Sustitutos["Transparent"] or Sustitutos["Standard"]
            elseif bType == "Invisible" then
                template = Sustitutos["Invisible"] or Sustitutos["Standard"]
            elseif bType == "InvisibleLight" then
                template = Sustitutos["InvisibleLight"] or Sustitutos["LightBlock"] or Sustitutos["Standard"]
            elseif bType == "Sphere" then
                template = Sustitutos["Sphere"] or Sustitutos["Standard"]
            elseif bType == "Wedge" then
                template = Sustitutos["Wedge"] or Sustitutos["Standard"]
            elseif bType == "Stud" then
                template = Services.RS.Assets.Basic.StudBlock or Sustitutos["Stud"] or Sustitutos["Standard"]
            end

            if not template then
                template = Sustitutos["Standard"]
                if not template then
                    processed = processed + 1
                    failedCount = failedCount + 1
                    if settings.showWarnings then warn("No template for block", i) end
                    continue
                end
            end

            local prevPart = currentPreviewModel:FindFirstChild(tostring(i))
            if not prevPart then
                processed = processed + 1
                failedCount = failedCount + 1
                if settings.showWarnings then warn("Preview part missing for block", i) end
                continue
            end

            local tPosCF = prevPart.CFrame
            local finalPos = tPosCF.Position
            local spawnPos = Vector3.new(finalPos.X, 4000, finalPos.Z)
            local finalSize = Vector3.new(unpack(s))
            local color = Color3.new(unpack(c))

            local placeOptions = {
                Billboard = "None",
                Scalable = true,
                ScalableFaces = "All"
            }
            if bType == "Invisible" then
                placeOptions = {
                    Billboard = "None",
                    Scalable = true,
                    Description = "Cannot be passed through.",
                    ScalableFaces = "All"
                }
            elseif bType == "InvisibleLight" then
                placeOptions = {
                    Billboard = "DefaultBlock",
                    Scalable = false,
                    Description = "The light block emits a light source.",
                    LinkType = "Input"
                }
            elseif bType == "Stud" then
                placeOptions = {
                    Billboard = "DefaultBlock",
                    Scalable = true,
                    Description = "The stud block serves as a regular block with the ROBLOX legacy surfaces.",
                    ScalableFaces = "All"
                }
            elseif light and light.lightType == "Surface" then
                placeOptions = {
                    Billboard = "DefaultBlock",
                    Scalable = true,
                    ScalableFaces = "All",
                    Description = "The surface light emits a light source from only the front surface of the block.",
                    LinkType = "Input"
                }
            elseif light and light.lightType == "Spot" then
                placeOptions = {
                    Billboard = "DefaultBlock",
                    Scalable = false,
                    Description = "The spotlight emits a light source in a cone-like form.",
                    LinkType = "Input"
                }
            end

            if settings.skipDuplicates then
                local existing = nil
                pcall(function()
                    local region = Region3.new(finalPos - Vector3.new(0.5,0.5,0.5), finalPos + Vector3.new(0.5,0.5,0.5))
                    for _, part in ipairs(workspace:FindPartsInRegion3(region, nil, math.huge)) do
                        if part:IsA("BasePart") and not part:IsDescendantOf(lp.Character) then
                            existing = part
                            break
                        end
                    end
                end)
                if existing then
                    processed = processed + 1
                    skippedCount = skippedCount + 1
                    prevPart:Destroy()
                    continue
                end
            end

            local blockInfo = {
                index = i,
                template = template,
                spawnPos = spawnPos,
                finalPos = finalPos,
                finalCF = tPosCF,
                finalSize = finalSize,
                color = color,
                material = material,
                transparency = transparency,
                bType = bType,
                light = light,
                prevPart = prevPart,
                placed = false,
                placeOptions = placeOptions
            }
            table.insert(blocksToBuild, blockInfo)

            local placed = false
            for attempt = 1, 3 do
                if uploadCancelFlag then break end
                local success, err = pcall(function()
                    pb:FireServer(
                        CFrame.new(spawnPos),
                        placeOptions,
                        color,
                        material,
                        template,
                        0,
                        false
                    )
                end)
                if success then
                    placed = true
                    break
                else
                    if settings.showWarnings then warn("PlaceBlock attempt ", attempt, " failed: ", err) end
                    task.wait(0.5)
                end
            end

            if not placed then
                processed = processed + 1
                failedCount = failedCount + 1
                if settings.showWarnings then warn("PlaceBlock failed after retries for block", i) end
                continue
            end

            task.wait(0.2)

            local currentBlock = findPlacedBlock(spawnPos, math.floor(searchTimeout / 0.1))

            if currentBlock then
                local moved = false
                for _ = 1, 2 do
                    if uploadCancelFlag then break end
                    local success, err = pcall(function()
                        cm:FireServer(currentBlock, tPosCF)
                    end)
                    if success then moved = true; break
                    else
                        if settings.showWarnings then warn("MoveBlock failed, retrying...", err) end
                        task.wait(0.2)
                    end
                end

                if bType ~= "InvisibleLight" then
                    local scaled = false
                    for _ = 1, 2 do
                        if uploadCancelFlag then break end
                        local success, err = pcall(function()
                            cr:FireServer(currentBlock, finalSize, tPosCF)
                        end)
                        if success then scaled = true; break
                        else
                            if settings.showWarnings then warn("ScaleBlock failed, retrying...", err) end
                            task.wait(0.2)
                        end
                    end
                end

                if paint then
                    local painted = false
                    for _ = 1, 2 do
                        if uploadCancelFlag then break end
                        local success, err = pcall(function()
                            paint:FireServer(currentBlock, color, material, transparency)
                        end)
                        if success then painted = true; break
                        else
                            if settings.showWarnings then warn("PaintBlock failed, retrying...", err) end
                            task.wait(0.2)
                        end
                    end
                end

                if ar and (d.r[1] ~= 0 or d.r[2] ~= 0 or d.r[3] ~= 0) then
                    task.wait(0.1)
                    pcall(function()
                        ar:FireServer(currentBlock, tPosCF)
                    end)
                end

                blockInfo.placed = true
                prevPart:Destroy()
            else
                failedCount = failedCount + 1
                if settings.showWarnings then warn("Block not found after placement for block", i) end
            end

            processed = processed + 1

            if processed % UPDATE_INTERVAL == 0 or processed == total then
                if uploadCancelFlag then
                    Status.Text = translate("Upload Cancelled by user")
                    ProgressFrame.Visible = false
                    return
                end
                local percent = processed / total
                local elapsed = tick() - startTime
                local remaining = (processed < total) and ((elapsed / processed) * (total - processed)) or 0
                Fill.Size = UDim2.new(percent, 0, 0, 12)
                ProgressText.Text = string.format("%s %d%% | Est: %s | %s%d | %s%d",
                    translate("Blocks:"), math.floor(percent*100), formatTime(remaining),
                    translate(" (fails: "), failedCount, " Skipped: ", skippedCount)
                Status.Text = translate("Blocks: ") .. processed .. "/" .. total .. translate(" (fails: ") .. failedCount .. ")"
                task.wait()
            end

            task.wait(dynamicWaitTime)
        end

        if not uploadCancelFlag then
            ProgressText.Text = "Recovery pass..."
            task.wait(0.5)

            local pbContainer = workspace:FindFirstChild("PlacedBlocks") or workspace:FindFirstChild("Blocks") or workspace
            if pbContainer and remove then
                for _, v in ipairs(pbContainer:GetChildren()) do
                    local pos = v:GetPivot().Position
                    if pos.Y > 3900 then
                        local isExpected = false
                        for _, info in ipairs(blocksToBuild) do
                            if info.placed and (info.finalPos - pos).Magnitude < 1 then
                                isExpected = true
                                break
                            end
                        end
                        if not isExpected then
                            pcall(function()
                                remove:FireServer(v)
                            end)
                        end
                    end
                end
            end

            local recoveryAttempts = 0
            for _, info in ipairs(blocksToBuild) do
                if uploadCancelFlag then break end
                if not info.placed then
                    local existing = nil
                    pcall(function()
                        local region = Region3.new(info.finalPos - Vector3.new(0.5,0.5,0.5), info.finalPos + Vector3.new(0.5,0.5,0.5))
                        for _, part in ipairs(workspace:FindPartsInRegion3(region, nil, math.huge)) do
                            if part:IsA("BasePart") and not part:IsDescendantOf(lp.Character) then
                                existing = part
                                break
                            end
                        end
                    end)
                    if existing then info.placed = true continue end

                    local placed = false
                    for attempt = 1, 3 do
                        if uploadCancelFlag then break end
                        local success, err = pcall(function()
                            pb:FireServer(
                                CFrame.new(info.spawnPos),
                                info.placeOptions,
                                info.color,
                                info.material,
                                info.template,
                                0,
                                false
                            )
                        end)
                        if success then
                            placed = true
                            break
                        else
                            if settings.showWarnings then warn("Recovery attempt ", attempt, " failed: ", err) end
                            task.wait(0.5)
                        end
                    end

                    if placed then
                        task.wait(0.3)
                        local currentBlock = findPlacedBlock(info.spawnPos, math.floor(searchTimeout / 0.1))
                        if currentBlock then
                            pcall(function() cm:FireServer(currentBlock, info.finalCF) end)
                            if info.bType ~= "InvisibleLight" then
                                pcall(function() cr:FireServer(currentBlock, info.finalSize, info.finalCF) end)
                            end
                            if paint then
                                pcall(function() paint:FireServer(currentBlock, info.color, info.material, info.transparency) end)
                            end
                            if ar and (info.finalCF:ToOrientation() ~= 0) then
                                pcall(function() ar:FireServer(currentBlock, info.finalCF) end)
                            end
                            info.placed = true
                            recoveryAttempts = recoveryAttempts + 1
                        end
                    end
                end
            end

            if recoveryAttempts > 0 then
                showNotification("Recovery: " .. recoveryAttempts .. " blocks rebuilt", 2, Colors.Success)
            end
        end

        if uploadCancelFlag then
            Status.Text = translate("Upload Cancelled by user")
            ProgressFrame.Visible = false
            return
        end

        Status.Text = translate("Upload Finished") .. " (" .. total .. " elements, fails: " .. failedCount .. ", skipped: " .. skippedCount .. ")"
        showNotification("Upload finished! " .. total .. " blocks", 3, Colors.Success)
        if settings.autoClearPreview then
            PreviewFolder:ClearAllChildren()
            currentPreviewModel = nil
            cleanupHandles()
        end
        task.wait(1)
        ProgressFrame.Visible = false
    end)
end)
