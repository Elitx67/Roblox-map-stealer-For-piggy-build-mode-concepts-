local CLASIC_MATERIALS = {
    "Plastic", "Wood", "Brick", "Metal", "Glass", "Concrete",
    "Marble", "Granite", "Slate", "Sandstone", "Cobblestone",
    "Grass", "Ice", "Snow", "Water", "Rubber"
}
local function isClassicMaterial(name)
    for _, m in ipairs(CLASIC_MATERIALS) do
        if m == name then return true end
    end
    return false
end
local function getClassicMaterial(name)
    if isClassicMaterial(name) then
        return Enum.Material[name]
    else
        return Enum.Material.Plastic
    end
end

local Sustitutos = {}
local function loadAssets()
    pcall(function()
        local assets = Services.RS:FindFirstChild("Assets")
        if not assets then return end
        
        local basic = assets:FindFirstChild("Basic")
        if basic then
            Sustitutos["Standard"] = basic:FindFirstChild("Block")
            Sustitutos["Sphere"] = basic:FindFirstChild("Ball") or basic:FindFirstChild("Sphere")
            Sustitutos["Wedge"] = basic:FindFirstChild("Wedge")
            Sustitutos["Cylinder"] = basic:FindFirstChild("Cylinder")
            Sustitutos["Transparent"] = basic:FindFirstChild("TransparentBlock") or Sustitutos["Standard"]
            Sustitutos["NoClip"] = basic:FindFirstChild("NoclipBlock") or Sustitutos["Standard"]
            Sustitutos["Stud"] = basic:FindFirstChild("StudBlock") or basic:FindFirstChild("Stud") or Sustitutos["Standard"]
        end
        
        local events = assets:FindFirstChild("Events")
        if events then
            Sustitutos["Invisible"] = events:FindFirstChild("InvisibleBlock") or Sustitutos["Standard"]
            Sustitutos["NoClipEvent"] = events:FindFirstChild("NoClipBlock") or events:FindFirstChild("NoClip") or Sustitutos["Standard"]
        end
        
        local lights = assets:FindFirstChild("Lights")
        if lights then
            Sustitutos["LightBlock"] = lights:FindFirstChild("LightBlock")
            Sustitutos["SurfaceLight"] = lights:FindFirstChild("SurfaceLight")
            Sustitutos["Spotlight"] = lights:FindFirstChild("Spotlight")
            Sustitutos["InvisibleLight"] = Sustitutos["LightBlock"] or Sustitutos["Standard"]
        end
        
        if not Sustitutos["Standard"] then
            Sustitutos["Standard"] = Instance.new("Part")
        end
        if not Sustitutos["Invisible"] then Sustitutos["Invisible"] = Sustitutos["Standard"] end
        if not Sustitutos["LightBlock"] then Sustitutos["LightBlock"] = Sustitutos["Standard"] end
        if not Sustitutos["InvisibleLight"] then Sustitutos["InvisibleLight"] = Sustitutos["Standard"] end
        if not Sustitutos["Sphere"] then Sustitutos["Sphere"] = Sustitutos["Standard"] end
        if not Sustitutos["Wedge"] then Sustitutos["Wedge"] = Sustitutos["Standard"] end
        if not Sustitutos["Cylinder"] then Sustitutos["Cylinder"] = Sustitutos["Standard"] end
        if not Sustitutos["Stud"] then Sustitutos["Stud"] = Sustitutos["Standard"] end
    end)
end
loadAssets()

