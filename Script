                        if format == "NEW" then
                            table.insert(data, { pt = pType, p = {p.Position.X, p.Position.Y, p.Position.Z}, r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z}, s = {reducedSize.X, reducedSize.Y, reducedSize.Z}, c = color, t = transparency, m = materialName, light = nil })
