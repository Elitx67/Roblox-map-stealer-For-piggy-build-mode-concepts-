        PaintBlock = buildEvents:FindFirstChild("PaintBlock"),
        RemoveBlock = buildEvents:FindFirstChild("RemoveBlock"),
        AdvancedRotate = buildEvents:FindFirstChild("AdvancedRotate")
    }
end

local function getPiggyBlockType(p)
    local sName = "Block"
    pcall(function()
        if p:IsA("TrussPart") then
            return "Normal"
        elseif p:IsA("Part") then
            sName = p.Shape.Name
        end
    end)
    local lowName = p.Name:lower()
    local hasLight = p:FindFirstChildWhichIsA("PointLight") or p:FindFirstChildWhichIsA("SurfaceLight") or p:FindFirstChildWhichIsA("SpotLight")
    
    local hasStuds = false
    pcall(function()
        if p.TopSurface == Enum.SurfaceType.Studs or p.BottomSurface == Enum.SurfaceType.Studs or p.LeftSurface == Enum.SurfaceType.Studs or p.RightSurface == Enum.SurfaceType.Studs or p.FrontSurface == Enum.SurfaceType.Studs or p.BackSurface == Enum.SurfaceType.Studs then
            hasStuds = true
        end
    end)

    if lowName:find("noclip") then return "NoClip"
    elseif lowName:find("truss") or lowName:find("ladder") then return "Normal"
    elseif lowName:find("stud") or hasStuds then return "Stud"
    elseif sName == "Cylinder" or lowName:find("cylinder") then return "Cylinder"
    elseif (p.Transparency > 0 and p.Transparency < 0.9) or p.Material.Name == "Glass" then return "Transparent"
    elseif lowName:find("invisible") or p.Transparency >= 0.9 then
        if hasLight then return "InvisibleLight" else return "Invisible" end
    elseif sName == "Ball" or sName == "Sphere" then return "Sphere"
    elseif sName == "Wedge" or lowName:find("wedge") then return "Wedge"
    end
    return "Normal"
end

